{
  "name": "ev-site-planner-suite",
  "version": "1.0.0",
  "private": true,
  "description": "EV Site Planner: browser-based survey, markup and planning tools for UK EV charge point installers.",
  "type": "module",
  "scripts": {
    "build": "python3 scripts/build-site.py",
    "start": "node serve.mjs",
    "serve": "node serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/workspace.browser.cjs",
    "test:profile": "node tests/profile.browser.cjs",
    "test:design": "node tests/design.browser.cjs"
  },
  "engines": {
    "node": ">=18"
  }
}
